{
  "apiVersion": "v1", "kind": "Pod",
  "metadata": {
    "name": "exporter",
    "namespace": "payments",
    "annotations": {
      "lex.dev/egress": "metrics.internal:9090",
      "app.kubernetes.io/description": "ships metrics to the internal collector"
    }
  },
  "spec": {
    "serviceAccountName": "exporter",
    "containers": [{
      "name": "exporter",
      "image": "registry.internal/payments/exporter@sha256:aa11bb22cc33dd44ee55ff6677889900aabbccddeeff00112233445566778899",
      "securityContext": { "allowPrivilegeEscalation": false, "capabilities": { "drop": ["ALL"] } }
    }]
  }
}
