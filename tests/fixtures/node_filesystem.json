{
  "apiVersion": "v1", "kind": "Pod",
  "metadata": { "name": "log-shipper", "namespace": "observability" },
  "spec": {
    "hostNetwork": true,
    "volumes": [
      { "name": "varlog", "hostPath": { "path": "/var/log", "type": "Directory" } },
      { "name": "docker", "hostPath": { "path": "/var/lib/docker/containers", "type": "Directory" } }
    ],
    "containers": [{
      "name": "fluentd",
      "image": "docker.io/fluent/fluentd:v1.17",
      "volumeMounts": [
        { "name": "varlog", "mountPath": "/var/log", "readOnly": true },
        { "name": "docker", "mountPath": "/var/lib/docker/containers", "readOnly": true }
      ]
    }]
  }
}
